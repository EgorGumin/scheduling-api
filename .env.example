DATABASE_URL=postgres://comments:comments@localhost:5433/comments

# The account replies are posted as. The app password is issued in the Bluesky
# app under Settings, Privacy and security, App passwords.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# A post of that account's own, which the live write test answers and then
# deletes. Any `at://` uri from its own thread will do.
BLUESKY_FIXTURE_POST=
