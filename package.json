{
  "name": "comments-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.41",
    "@atproto/common-web": "^0.5.9",
    "@atproto/syntax": "^0.7.4",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.12.1",
    "graphile-worker": "^0.17.3",
    "postgres": "^3.4.7",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
